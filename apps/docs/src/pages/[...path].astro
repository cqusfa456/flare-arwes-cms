---
import { getCollection } from 'astro:content'
import MarkdownIt from 'markdown-it'

import Layout from '@/layouts/Layout.astro'
import { settings } from '@/config/settings'
import { routes, getTitle } from '@/router/routes'
import { CmsPage } from '@/cms/CmsPage'

// Build the static paths: the app routes plus the CMS-managed pages.
export async function getStaticPaths() {
  // Markdown renderer for CMS page content.
  const md = new MarkdownIt({ html: true, linkify: true, typographer: true })

  // Fetch all pages managed by the Flare CMS admin.
  const cmsPages = await getCollection('pages')

  const appPaths = routes.map((route) => ({
    params: { path: route === '/' ? undefined : route.slice(1) },
    props: { pathname: route, cmsPage: undefined }
  }))

  const cmsPaths = cmsPages.map((page) => ({
    params: { path: page.data.slug },
    props: {
      pathname: `/${page.data.slug}`,
      cmsPage: {
        title: page.data.title,
        contentHtml: md.render(String(page.data.content ?? '')),
        metaDescription: page.data.meta_description
      }
    }
  }))

  return [...appPaths, ...cmsPaths]
}

const { pathname, cmsPage } = Astro.props
---

<Layout title={cmsPage ? `${cmsPage.title} | ${settings.title}` : getTitle(pathname)} pathname={pathname}>
  {cmsPage && <CmsPage client:load {...cmsPage} />}
</Layout>
