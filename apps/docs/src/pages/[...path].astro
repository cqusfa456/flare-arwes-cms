---
import { getCollection } from 'astro:content'
import MarkdownIt from 'markdown-it'

import Layout from '@/layouts/Layout.astro'
import { settings } from '@/config/settings'
import { routes, getTitle } from '@/router/routes'
import { CmsPage } from '@/cms/CmsPage'
import { DocsCmsPage } from '@/cms/DocsCmsPage'
import { BlogPostPage } from '@/cms/BlogPostPage'
import { BlogIndexPage } from '@/cms/BlogIndexPage'
import {
  collectionIndexPath,
  contentPath,
  getCollectionPrefixes,
  isAppSite,
  pagePath
} from '@/lib/cms-collections'

// Build the static paths.
//
// Where content is published comes from the CMS, in two layers (see
// src/lib/cms-collections.ts): each collection's URL prefix, and the site's
// `content_routes` when it is a content-only host such as a blog subdomain.
//
// Ownership rules:
//   * documentation and the blog own their trees;
//   * every other path — including the front page — can be claimed by a CMS page,
//     and such a page wins over the app's own route, so those pages are managed in
//     the CMS instead of in code;
//   * a content-only site publishes only its collections and none of the app's
//     routes.
export async function getStaticPaths() {
  // Kept inside the function: a module-scope helper does not survive the
  // static-paths bundling.
  const stripTrailing = (value: string): string =>
    value.length > 1 ? value.replace(/\/+$/, '') : value

  // Markdown renderer for CMS content.
  const md = new MarkdownIt({ html: true, linkify: true, typographer: true })

  const [prefixes, appSite, cmsPages, cmsDocs, cmsPosts, cmsSections] = await Promise.all([
    getCollectionPrefixes(),
    isAppSite(),
    getCollection('pages'),
    getCollection('docs'),
    getCollection('posts'),
    getCollection('docsSections')
  ])

  const docsPrefix = prefixes.get('docs')
  const postsPrefix = prefixes.get('blog-posts')
  const pagesPrefix = prefixes.get('pages')

  const docsBase = collectionIndexPath(docsPrefix)
  const postsBase = collectionIndexPath(postsPrefix)
  const isDocsOrBlog = (path: string): boolean =>
    [docsBase, postsBase].some(
      (base) => base !== null && (stripTrailing(path) === base || stripTrailing(path).startsWith(`${base}/`))
    )

  const claimed = new Set<string>()
  const claim = (path: string): boolean => {
    const key = stripTrailing(path)
    if (!key || claimed.has(key)) {
      return false
    }
    claimed.add(key)
    return true
  }

  const cmsPageProps = (page: { data: Record<string, any> }): Record<string, unknown> => ({
    title: page.data.title,
    contentHtml: md.render(String(page.data.content ?? '')),
    // `excerpt` is the summary field of the CMS's built-in collections;
    // `meta_description` is what pages created earlier carry.
    metaDescription: page.data.excerpt ?? page.data.meta_description
  })

  // 1. CMS pages claim their paths first. Outside the docs and blog trees they
  //    take precedence, so "everything that is not documentation or the blog" —
  //    including the front page — can live in the `pages` collection.
  const pageRoutes = new Map<string, Record<string, unknown>>()
  for (const page of cmsPages) {
    const slug = String(page.data.slug ?? '')
    const path = pagePath(slug, pagesPrefix)

    if (!path) {
      continue
    }
    if (isDocsOrBlog(path)) {
      console.warn(`[routing] page "${slug}" would sit inside docs or the blog; skipped (${path})`)
      continue
    }
    if (!claim(path)) {
      console.warn(`[routing] page "${slug}" duplicates ${path}; skipped`)
      continue
    }
    pageRoutes.set(path, cmsPageProps(page))
  }

  // 2. The app's own routes, minus the ones a CMS page took over. A content-only
  //    site has none: it serves its collections and nothing else.
  const appRoutePaths = appSite ? routes.filter((route) => !claimed.has(stripTrailing(route))) : []
  for (const route of appRoutePaths) {
    claimed.add(stripTrailing(route))
  }

  const appPaths = appRoutePaths.map((route) => ({
    params: { path: route === '/' ? undefined : route.slice(1) },
    props: { pathname: route, cmsPage: undefined }
  }))

  const pagePaths = [...pageRoutes.entries()].map(([path, cmsPage]) => ({
    params: { path: path === '/' ? undefined : path.replace(/^\//, '') },
    props: { pathname: stripTrailing(path), cmsPage }
  }))

  // 3. Blog posts.
  const postPaths = cmsPosts.flatMap((post) => {
    const path = contentPath(postsPrefix, post.data.slug)
    if (!path || !claim(path)) {
      return []
    }
    return [
      {
        params: { path: path.replace(/^\//, '') },
        props: {
          pathname: stripTrailing(path),
          blog: true,
          cmsPage: {
            title: post.data.title,
            contentHtml: md.render(String(post.data.content ?? '')),
            metaDescription: post.data.excerpt ?? post.data.meta_description,
            // The loader exposes the publish date as the `_publishedAt` system
            // field (`published_at` never reaches the page: the API transform
            // dropped the column and Astro strips undeclared schema keys).
            publishedAt: post.data._publishedAt
              ? new Date(post.data._publishedAt).toISOString().slice(0, 10)
              : undefined
          }
        }
      }
    ]
  })

  // 4. Documentation. Sections only group content administratively, so a doc's
  //    URL does not include one: it can move between sections without breaking
  //    links.
  const sectionSlugById = new Map(cmsSections.map((section: any) => [section.id, section.data.slug]))
  const navSections = cmsSections.map((section: any) => ({
    slug: section.data.slug,
    name: section.data.name,
    order: section.data.order
  }))
  const navDocs = cmsDocs.map((doc: any) => {
    const ref = doc.data.section ?? doc.data.sectionSlug
    return {
      slug: doc.data.slug,
      title: doc.data.title,
      // Resolved here so the sidebar follows the collection's prefix instead of
      // assuming /docs.
      href: contentPath(docsPrefix, doc.data.slug),
      section: sectionSlugById.get(ref) ?? ref,
      order: doc.data.order
    }
  })

  const docsPaths = cmsDocs.flatMap((doc) => {
    const path = contentPath(docsPrefix, doc.data.slug)
    if (!path || !claim(path)) {
      return []
    }
    return [
      {
        params: { path: path.replace(/^\//, '') },
        props: {
          pathname: stripTrailing(path),
          docs: true,
          navData: JSON.stringify({ sections: navSections, docs: navDocs }),
          cmsPage: {
            title: doc.data.title,
            contentHtml: md.render(String(doc.data.content ?? '')),
            metaDescription: doc.data.excerpt
          }
        }
      }
    ]
  })

  // 5. The blog index, at its collection's prefix (the host root on a blog site).
  const blogIndexPath = collectionIndexPath(postsPrefix)
  const hasBlogIndex = blogIndexPath !== null && claim(blogIndexPath)
  const indexPaths = hasBlogIndex
    ? [
        {
          params: { path: blogIndexPath === '/' ? undefined : blogIndexPath.replace(/^\//, '') },
          props: {
            pathname: blogIndexPath,
            blogIndex: true,
            // The blog index is not an app route, so `getTitle()` cannot name it.
            pageTitle: `Blog | ${settings.title}`,
            posts: [...cmsPosts]
              .sort(
                (a, b) =>
                  (b.data._publishedAt?.getTime() ?? 0) - (a.data._publishedAt?.getTime() ?? 0)
              )
              .map((post) => ({
                // The link is resolved here, at build time: the island must not
                // import the routing helper (it reads build-only env).
                href: contentPath(postsPrefix, post.data.slug),
                slug: post.data.slug,
                title: post.data.title,
                publishedAt: post.data._publishedAt
                  ? new Date(post.data._publishedAt).toISOString().slice(0, 10)
                  : undefined,
                summary: post.data.excerpt ?? post.data.meta_description
              }))
          }
        }
      ]
    : []

  return [...appPaths, ...pagePaths, ...postPaths, ...docsPaths, ...indexPaths]
}

const { pathname, cmsPage, docs, blog, blogIndex, posts, navData, pageTitle } = Astro.props
---

<Layout
  title={pageTitle ?? (cmsPage ? `${cmsPage.title} | ${settings.title}` : getTitle(pathname))}
  pathname={pathname}
>
  {/*
    `navData` must be passed explicitly: `{...cmsPage}` only spreads the page
    fields, so spreading alone left the island with title/contentHtml only and
    rendered an empty sidebar with no error.
  */}
  {docs && cmsPage && <DocsCmsPage client:load {...cmsPage} navData={navData} pathname={pathname} />}
  {blog && cmsPage && <BlogPostPage client:load {...cmsPage} />}
  {!docs && !blog && !blogIndex && cmsPage && <CmsPage client:load {...cmsPage} />}
  {blogIndex && <BlogIndexPage client:load posts={posts} />}
</Layout>
