---
import { getCollection } from 'astro:content'
import MarkdownIt from 'markdown-it'

import Layout from '@/layouts/Layout.astro'
import { settings } from '@/config/settings'
import { routes, getTitle } from '@/router/routes'
import { CmsPage } from '@/cms/CmsPage'
import { DocsCmsPage } from '@/cms/DocsCmsPage'
import { BlogPostPage } from '@/cms/BlogPostPage'

// Build the static paths: the app routes plus the CMS-managed pages.
export async function getStaticPaths() {
  // Markdown renderer for CMS page content.
  const md = new MarkdownIt({ html: true, linkify: true, typographer: true })

  // Fetch all pages managed by the Sci-Fi CMS admin.
  const cmsPages = await getCollection('pages')

  // Documentation managed in the CMS renders under /docs/<slug>. Sections only
  // group content administratively, so the URL stays flat and a page can move
  // between sections without breaking links.
  const cmsDocs = await getCollection('docs')

  const appPaths = routes.map((route) => ({
    params: { path: route === '/' ? undefined : route.slice(1) },
    props: { pathname: route, cmsPage: undefined }
  }))

  const cmsPaths = cmsPages.map((page) => ({
    params: { path: `blog/${page.data.slug}` },
    props: {
      pathname: `/blog/${page.data.slug}`,
      blog: true,
      cmsPage: {
        title: page.data.title,
        contentHtml: md.render(String(page.data.content ?? '')),
        metaDescription: page.data.meta_description,
        publishedAt: page.data.published_at
      }
    }
  }))

  // Sidebar data: sections for the headings, docs for the links. A page
  // whose section is not in the CMS section list still appears (unlabelled),
  // so content cannot become unreachable.
  const navSections = (await getCollection('docsSections')).map((section: any) => ({
    slug: section.data.slug,
    name: section.data.name,
    order: section.data.order
  }))
  const navDocs = cmsDocs.map((doc: any) => ({
    slug: doc.data.slug,
    title: doc.data.title,
    section: doc.data.section ?? doc.data.sectionSlug,
    order: doc.data.order
  }))

  const docsPaths = cmsDocs.map((doc) => ({
    params: { path: `docs/${doc.data.slug}` },
    props: {
      pathname: `/docs/${doc.data.slug}`,
      docs: true,
      navSections,
      navDocs,
      cmsPage: {
        title: doc.data.title,
        contentHtml: md.render(String(doc.data.content ?? '')),
        metaDescription: doc.data.excerpt
      }
    }
  }))

  return [...appPaths, ...cmsPaths, ...docsPaths]
}

const { pathname, cmsPage, docs, blog } = Astro.props
---

<Layout title={cmsPage ? `${cmsPage.title} | ${settings.title}` : getTitle(pathname)} pathname={pathname}>
  {docs && cmsPage && <DocsCmsPage client:load {...cmsPage} />}
  {!docs && !blog && cmsPage && <CmsPage client:load {...cmsPage} />}
  {blog && cmsPage && <BlogPostPage client:load {...cmsPage} />}
</Layout>
