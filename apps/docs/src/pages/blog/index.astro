---
import { getCollection } from 'astro:content'

import Layout from '@/layouts/Layout.astro'
import { settings } from '@/config/settings'
import { BlogIndexPage } from '@/cms/BlogIndexPage'

// Blog index: CMS *pages*, newest first. Posts live at /blog/<slug> (see
// [...path].astro); this page only lists them.
//
// `_publishedAt` is the loader's publish-date system field, and a CMS page
// carries `meta_description` rather than an `excerpt`, which is the `docs`
// collection's field.
//
// The list is rendered by a React island so it animates in like every other
// page. Only plain values cross the island boundary.
const posts = (await getCollection('pages'))
  .sort((a, b) => (b.data._publishedAt?.getTime() ?? 0) - (a.data._publishedAt?.getTime() ?? 0))
  .map((post) => ({
    slug: post.data.slug,
    title: post.data.title,
    publishedAt: post.data._publishedAt?.toISOString().slice(0, 10),
    summary: post.data.meta_description
  }))
---

<Layout title={`Blog | ${settings.title}`} pathname="/blog">
  <BlogIndexPage client:load posts={posts} />
</Layout>
