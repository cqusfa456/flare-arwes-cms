---
/**
 * The site's navigation, rendered from the CMS.
 *
 * A layout includes this where the menu belongs, so the shared chrome lives in the
 * layout instead of being hardcoded in the site shell:
 *
 *   <CmsNav />                            the menu the path selects
 *   <CmsNav navKey="home" />              a specific menu from Admin -> Content -> Navigation
 *   <CmsNav navKey={navKey} class="..." />  the menu the page itself selects
 *
 * The `navKey` prop is what a generated page passes down to its CMS layout, so a
 * page that names a menu (`nav` field) keeps it wherever it is published.
 *
 * It renders nothing when the CMS defines no menu, so a layout can include it
 * unconditionally.
 */
import { getSiteRouting } from '@/lib/cms-collections'
import { getNavigation } from '@/lib/site-content'
import { isRoute } from '@/router/routes'

interface Props {
  /** Menu key; the site rule picks one when omitted. */
  navKey?: string
  /** Alias of `navKey`, for layouts that read better with the short name. */
  key?: string
  /** Path being rendered, so the active item can be marked. */
  pathname?: string
  class?: string
}

const { navKey, key, pathname: pathnameProp, class: className } = Astro.props
const pathname = (pathnameProp ?? Astro.url.pathname).replace(/\/+$/, '') || '/'
const items = await getNavigation(pathname, navKey ?? key)

// On a content-only host (a blog subdomain) the app's own routes are published by
// the main site, so a menu link to one has to be absolute or it would ask this host
// for a page it does not have. The root stays local: there it is the collection's
// own index. This is the same rule the client router applies (src/router/Link.tsx).
const routing = await getSiteRouting()
const appBase = routing.appBaseUrl ? routing.appBaseUrl.replace(/\/+$/, '') : null

const resolveHref = (href: string): string => {
  if (!appBase || !href.startsWith('/') || href.startsWith('//')) {
    return href
  }
  const clean = href.replace(/\/+$/, '') || '/'
  return clean !== '/' && isRoute(clean) ? `${appBase}${href}` : href
}
---

{
  items.length > 0 && (
    <nav
      class:list={[
        'flex flex-row flex-wrap items-center justify-center gap-1 md:gap-2',
        className
      ]}
    >
      {items.map((item) => {
        const href = resolveHref(item.href)
        const target = item.href.replace(/\/+$/, '') || '/'
        const active = pathname === target || pathname.startsWith(`${target}/`)
        return (
          <a
            class:list={[
              'px-3 py-2 font-cta text-size-10 uppercase no-underline transition-colors duration-200 ease-out',
              active
                ? 'text-secondary-main-5 hover:text-secondary-high-2'
                : 'text-primary-main-5 hover:text-primary-high-2'
            ]}
            href={href}
          >
            {item.label}
          </a>
        )
      })}
    </nav>
  )
}
