---
import { getCollection } from 'astro:content'

import { settings } from '@/config/settings'
import { routes } from '@/router/routes'
import { AppShell } from '@/AppShell'
import CmsLayout from '@/components/CmsLayout.astro'
import CmsComponent from '@/components/CmsComponent.astro'
import { CONTENT_ELEMENT_ID } from '@/lib/page-content'
import { collectionIndexHref, getCollectionPrefixes, getSiteRouting, pagePath } from '@/lib/cms-collections'
import { getLayout, getMenu, getNavigation } from '@/lib/site-content'

import '@/ui/globals.css'

interface LayoutProps {
  /** Document title (`<title>`, Open Graph). */
  title: string
  /** The page's own title, without the site suffix; layouts render this one. */
  pageTitle?: string
  pathname: string
  /** Menu this page selects; the site rule picks one when it names none. */
  navKey?: string
  /** Layout version framing this page; `default` when it names none. */
  layout?: string
  /**
   * Whether the markup this page passes in its slot is the whole content for this
   * path. A CMS page or a collection index says so; an app route does not, because
   * its content is rendered by the app itself (see `AppShell`).
   */
  hasServerContent?: boolean
  /** Override for the rule below: the shell never renders a menu of its own. */
  hideMenu?: boolean
}

const {
  title,
  pageTitle,
  pathname,
  navKey,
  layout,
  hasServerContent,
  hideMenu: hideMenuProp
} = Astro.props

// Every page is injected through the same layout: the version it names (a page
// field in the CMS, the `default` fallback), which frames the content and composes
// the footer.
const layoutEntry = await getLayout(layout)

// The header's menu is a CMS setting (see src/lib/site-content.ts). An empty
// result means the site's own built-in navigation is used.
const navItems = await getNavigation(pathname, navKey)

// The header's own links (the right-hand side) are the same on every page: they are
// a menu of their own, edited with the rest of the chrome.
const actionItems = await getMenu('links')

// The navigation bar is a shared component too, but it belongs in the header —
// that is where a menu sits on this site, on every page — so the site layout hands
// it to the shell, which renders it in place of its own menu. Without such a
// component the shell falls back to the CMS menus above, then to the built-in
// navigation, so a site that manages no chrome still has a menu.
const hasNavComponent = Object.keys(import.meta.glob('/src/cms-components/nav.astro')).length > 0
const hasLogoComponent =
  Object.keys(import.meta.glob('/src/cms-components/logo.astro')).length > 0

// A page's layout may render the chrome itself; then the shell keeps its menu out
// of the way. By default the header owns the menu.
const hideMenu = hideMenuProp ?? false

// Two CMS settings shape the shell's navigation:
//   * the blog link follows the `blog-posts` collection's prefix, and points at
//     another host when a secondary site publishes the blog there;
//   * a content-only host (a blog subdomain) links the app's own routes back to
//     the main site, because it does not generate them.
const [blogPath, routing, prefixes] = await Promise.all([
  collectionIndexHref('blog-posts'),
  getSiteRouting(),
  getCollectionPrefixes()
])
const appBaseUrl = routing.appBaseUrl ?? undefined

// A CMS page may own a path the app also declares (the front page, most often).
// The client router has to leave those alone, or a click would render the app's
// version of a page the build served from the CMS.
const cmsPages = await getCollection('pages')
const serverPaths = cmsPages
  .map((page) => pagePath(String(page.data.slug ?? ''), prefixes.get('pages')))
  .filter((path): path is string => path !== null)
  .map((path) => (path.length > 1 ? path.replace(/\/+$/, '') : path))
  .filter((path) => (routes as readonly string[]).includes(path))
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={settings.title} />
    <meta property="og:description" content={settings.description} />
    <meta property="og:image" content="https://next.arwes.dev/arwes.jpg" />
    <meta property="og:url" content="https://next.arwes.dev" />
    <meta property="og:type" content="website" />
    <meta name="twitter:image:alt" content={settings.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@arwesjs" />

    <meta name="theme-color" content={settings.background} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;600&family=Source+Code+Pro:wght@400&display=swap"
      rel="stylesheet"
    />

    <style is:inline>
      {`html, body { background: ${settings.background}; }`}
    </style>

    {/*
      Page transitions. A navigation to a server page (a CMS page, a collection
      index, the blog on its own host) is a document load, and the browser
      cross-fades between the two pages instead of flashing. The app's own
      navigations reuse the same animation through the View Transitions API (see
      src/router/Router.tsx), so every page change looks the same.

      Kept out of the stylesheet on purpose: the rule is new enough that the CSS
      pipeline of the moment may drop what it does not recognise.
    */}
    <style is:inline>
      @view-transition {
        navigation: auto;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 180ms;
        animation-timing-function: ease-out;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>

    {/*
      The page opens in one piece. `app-intro` is added before the first paint and
      removed when the shell mounts, so the frame does not show up before the header
      that belongs with it; the timeout means a shell that never loads still leaves a
      readable page.
    */}
    <script is:inline>
      (() => {
        const root = document.documentElement
        root.classList.add('app-intro')
        window.setTimeout(() => root.classList.remove('app-intro'), 2500)
      })()
    </script>

    <style is:inline>
      .app-frame {
        transition: opacity 400ms ease-out;
      }

      html.app-intro .app-frame {
        opacity: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        .app-frame {
          transition: none;
        }
      }
    </style>

    <title>{title}</title>
  </head>
  <body>
    <AppShell
      client:load
      pathname={pathname}
      blogPath={blogPath ?? undefined}
      appBaseUrl={appBaseUrl}
      serverPaths={serverPaths}
      navItems={navItems}
      actionItems={actionItems}
      logoContent={hasLogoComponent}
      hideMenu={hideMenu}
      hasServerContent={!!hasServerContent}
    >
      {/*
        The navigation bar, in the header where a menu belongs. It arrives as a
        named slot so the shell can place it next to the logo, and it is a CMS
        component like the footer: `components/nav` in Admin → Content → Components.
      */}
      {
        hasNavComponent && (
          <Fragment slot="nav">
            <CmsComponent name="nav" navKey={navKey} pathname={pathname} />
          </Fragment>
        )
      }
      {/*
        The logo, and the page it links to, are the site's too: `logo` in
        Admin → Content → 组件, with its `href` and `title` props.
      */}
      {
        hasLogoComponent && (
          <Fragment slot="logo">
            <CmsComponent name="logo" href="/" title={settings.title} />
          </Fragment>
        )
      }
      {/*
        The page is framed by the layout it selected. `navKey` travels with it so a
        layout can render the menu the page asked for (<CmsNav navKey={navKey} />),
        and `pageTitle` is its own title rather than the document's.

        The frame is wrapped so it can be held back until the shell is ready: the
        header is an island and animates itself in, so a frame that painted
        immediately would show the page in two pieces. `app-intro` is set before the
        first paint and lifted when the shell mounts (see AppShell).

        The frame decides where the content goes, and the marker inside marks that
        spot: a page with server content is rendered there by Astro, while an app
        route is rendered there by the app (`AppShell` portals into it), so the
        chrome the layout composes stays around either of them.
      */}
      <div class="app-frame flex-1 flex min-w-0 min-h-0">
        <CmsLayout
          name={layout}
          title={title}
          pageTitle={pageTitle ?? title}
          pathname={pathname}
          navKey={navKey}
        >
          <div id={CONTENT_ELEMENT_ID} class="contents">
            <slot />
          </div>
        </CmsLayout>
      </div>
    </AppShell>
  </body>
</html>
