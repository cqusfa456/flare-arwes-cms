{
  // Worker configuration for the docs site.
  //
  // Deployed with:
  //   cd apps/docs && npm run worker:build && npm run worker:deploy
  // (no Git connection required — see the note about Workers Builds below)
  //
  // Custom domains are NOT declared here: the CMS owns them (Admin → Sites)
  // and attaches them through the Workers custom-domains API.
  //
  // BILLING — why there is deliberately no `run_worker_first` here:
  //   Requests served as static assets are free and unlimited; only requests
  //   that invoke the Worker script are billed. `run_worker_first` makes every
  //   matching request invoke the script (and on the free tier an over-limit
  //   request returns 429 instead of falling back to asset serving), so leaving
  //   it off is what keeps this site's traffic free.
  //
  //   With a compatibility date >= 2025-04-01 the
  //   `assets_navigation_prefers_asset_serving` flag is on: a navigation to an
  //   existing HTML page (or any request that matches a file) is served from
  //   assets without invoking the Worker. The Worker below therefore only runs
  //   for requests that match NO file — a missing image fetched by script, or a
  //   non-navigation request — which is exactly the fallback we want to keep.
  //
  //   Trade-off: hostname → asset-prefix routing (SITE_ROUTES in src/worker.ts,
  //   i.e. one Worker serving several sites from subdirectories) needs the
  //   Worker to run first, and therefore makes every request billable. Prefer
  //   one Worker per site — which is what the CMS models (a site's
  //   `cfProjectName` is its Worker) — and restore `run_worker_first` only if
  //   you knowingly want the multi-site-in-one-Worker shape.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arwes-docs-worker",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-11",

  "assets": {
    // Astro output (astro.config.mjs sets outDir: 'build').
    "directory": "./build",
    "binding": "ASSETS",

    // Astro uses `build.format: 'directory'`, so pages are `about/index.html`.
    // `drop-trailing-slash` serves those directly at `/about` (only `/about/`
    // redirects), which keeps URLs stable AND needs no Worker invocation.
    // The default `auto-trailing-slash` would 307 `/about` → `/about/`, and
    // `none` would require the Worker to resolve every page (billable).
    "html_handling": "drop-trailing-slash",

    // Static 404 handling: the nearest 404.html is served with a 404 status
    // without invoking the Worker.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
