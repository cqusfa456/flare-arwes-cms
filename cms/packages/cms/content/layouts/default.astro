---
/**
 * The neutral layout: the shared chrome, and nothing else.
 *
 * Every page that is not framed by a more specific version gets this one. It
 * composes the site's shared components — the navigation bar and the footer bar —
 * and hands the rest of the height to the page, which keeps managing its own
 * scrolling and sidebars. That is what makes the chrome consistent across the
 * documentation, the blog and the CMS pages: the frame is here, the pages bring
 * content only.
 *
 * Props the page passes down:
 *   title     the page title (used by layouts that render a heading of their own)
 *   pathname  the path the page is published at
 *   navKey    the menu the page selected with its `nav` field, when it names one
 *
 * Edit it in Admin -> Content -> Layouts. Add another version next to it (for
 * instance `article`, which centres a column) and a page picks it with its own
 * `layout` field.
 */
import CmsComponent from '@/components/CmsComponent.astro'

const { navKey } = Astro.props
---

<div class="flex-1 flex flex-col min-w-0 min-h-0">
  <CmsComponent name="nav" navKey={navKey} />

  <div class="flex-1 flex min-w-0 min-h-0">
    <slot />
  </div>

  <CmsComponent name="footer" />
</div>
