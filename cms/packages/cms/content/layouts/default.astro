---
/**
 * The neutral layout: the footer bar, and nothing else around the page.
 *
 * Every page that is not framed by a more specific version gets this one. It hands
 * the height to the page, which keeps managing its own scrolling and sidebars, and
 * composes the shared components the frame owns — the footer bar. The navigation bar
 * is composed here too, but placed by the site layout in the header (see
 * `components/nav`), because that is where a menu belongs on every page.
 *
 * Props the page passes down:
 *   title     the page title (used by layouts that render a heading of their own)
 *   pathname  the path the page is published at
 *   navKey    the menu the page selected with its `nav` field, when it names one
 *
 * Edit it in Admin -> Content -> Layouts. Add another version next to it (for
 * instance `article`, which centres a column) and a page picks it with its own
 * `layout` field.
 */
import CmsComponent from '@/components/CmsComponent.astro'
---

<div class="flex-1 flex flex-col min-w-0 min-h-0">
  <div class="flex-1 flex min-w-0 min-h-0">
    <slot />
  </div>

  <CmsComponent name="footer" />
</div>
