---
/**
 * The site's navigation bar.
 *
 * A shared component, like the footer: the site layout hands it to the app shell,
 * which renders it in the header next to the logo, so the menu sits in the same
 * place on every page of the site.
 *
 * Its items come from the `navigation` collection (Admin -> Content -> Navigation),
 * so both the bar and what is in it are edited in the CMS.
 *
 * Props the site layout passes down:
 *   navKey    the menu the page selected with its `nav` field, when it names one
 *   pathname  the path being rendered, so the active item can be marked
 */
import CmsNav from '@/components/CmsNav.astro'

const { navKey, pathname } = Astro.props
---

<CmsNav navKey={navKey} pathname={pathname} class="flex-nowrap justify-start" />
